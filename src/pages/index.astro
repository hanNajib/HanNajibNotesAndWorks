---
export const prerender = true;
import Layout from "../layouts/Layout.astro";
import Feed from "../components/Feed.jsx";
import { supabase } from "../lib/supabase";

const { data: posts, error } = await supabase
	.from("posts")
	.select("*")
	.order("created_at", { ascending: false });

if (error) {
	console.error("Gagal Memuat Data");
}

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "WebSite",
	name: "HanNajib",
	 alternateName: ["HanNajib Notes", "HanNajib Blog"],
	url: "https://blog.hannajib.web.id/",
	description:
		"Selamat datang di ruang digital personal HanNajib. Tempat mendokumentasikan pemikiran mendalam (Notes), portofolio proyek (Works), catatan belajar harian (TIL), serta tangkapan visual estetik (Snaps).",
	publisher: {
		"@type": "Person",
		name: "Ahmad Royhan Najib",
		alternateName: "Han Najib",
		jobTitle: "Web Developer",
		url: Astro.url.origin,
		sameAs: [
			"https://github.com/hannajib",
			"https://www.youtube.com/@Hann.Undefined",
			"https://www.instagram.com/handefined/",
		],
	},
};
---

<Layout title="HanNajib — Notes & Works" showHero={true}>
	<script
		type="application/ld+json"
		slot="head"
		set:html={JSON.stringify(jsonLd)}
	></script>

	<Feed client:load posts={posts || []} />
</Layout>
