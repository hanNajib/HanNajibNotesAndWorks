---
import AdminLayout from "../../layouts/AdminLayout.astro";
---

<AdminLayout title="Admin Login — HanNajib">
    <div
        class="min-h-[50vh] flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8"
    >
        <div
            class="max-w-md w-full space-y-8 bg-white dark:bg-zinc-900 p-8 rounded-xl border border-zinc-200 dark:border-zinc-800 shadow-sm"
        >
            <!-- Judul Form -->
            <div>
                <h2
                    class="text-center text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50"
                >
                    Masuk sebagai Admin
                </h2>
                <p class="mt-2 text-center text-xs text-zinc-500 font-mono">
                    / otorisasi akses penuh
                </p>
            </div>

            <!-- Form Input -->
            <form class="mt-8 space-y-4" id="login-form">
                <div class="space-y-3">
                    <div>
                        <label
                            for="email-address"
                            class="block text-[10px] font-mono uppercase tracking-wider text-zinc-400 dark:text-zinc-500 mb-1"
                            >Email</label
                        >
                        <input
                            id="email-address"
                            name="email"
                            type="email"
                            autocomplete="email"
                            required
                            class="w-full px-3 py-2 text-xs rounded-lg border border-zinc-200 dark:border-zinc-800 bg-transparent focus:outline-none focus:border-zinc-400 dark:focus:border-zinc-600 transition-all text-zinc-800 dark:text-zinc-200"
                            placeholder="nama@email.com"
                        />
                    </div>
                    <div>
                        <label
                            for="password"
                            class="block text-[10px] font-mono uppercase tracking-wider text-zinc-400 dark:text-zinc-500 mb-1"
                            >Kata Sandi</label
                        >
                        <input
                            id="password"
                            name="password"
                            type="password"
                            autocomplete="current-password"
                            required
                            class="w-full px-3 py-2 text-xs rounded-lg border border-zinc-200 dark:border-zinc-800 bg-transparent focus:outline-none focus:border-zinc-400 dark:focus:border-zinc-600 transition-all text-zinc-800 dark:text-zinc-200"
                            placeholder="••••••••"
                        />
                    </div>
                </div>

                <div
                    id="error-message"
                    class="hidden text-xs text-red-500 font-medium text-center"
                >
                </div>

                <div>
                    <button
                        type="submit"
                        class="w-full py-2 text-xs font-medium rounded-lg bg-zinc-900 text-zinc-50 hover:bg-zinc-800 dark:bg-zinc-100 dark:text-zinc-900 dark:hover:bg-zinc-200 transition-colors shadow-sm cursor-pointer"
                    >
                        Masuk
                    </button>
                </div>
            </form>
        </div>
    </div>

    <script>
        import { supabase } from "../../lib/supabase";

        supabase.auth.getSession().then(({ data: { session } }) => {
            if (session) {
                window.location.href = "/admin";
            }
        });

        const loginForm = document.getElementById("login-form");
        const errorMsg = document.getElementById("error-message");

        // 2. Tangkap event kirim formulir
        loginForm?.addEventListener("submit", async (e) => {
            e.preventDefault();

            const email = document.getElementById("email-address").value;
            const password = document.getElementById("password").value;

            // Reset pesan error
            if (errorMsg) {
                errorMsg.classList.add("hidden");
                errorMsg.innerText = "";
            }

            const { data, error } = await supabase.auth.signInWithPassword({
                email,
                password,
            });

            if (error) {
                if (errorMsg) {
                    errorMsg.innerText = error.message;
                    errorMsg.classList.remove("hidden");
                }
            } else {
                window.location.href = "/admin";
            }
        });
    </script>
</AdminLayout>
