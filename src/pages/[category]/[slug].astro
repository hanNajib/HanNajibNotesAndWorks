---
export const prerender = true;
import Layout from "../../layouts/Layout.astro";
import { supabase } from "../../lib/supabase";

const parseMarkdownAlerts = (htmlContent) => {
    if (!htmlContent) return "";

    const regex =
        /<blockquote>\s*(?:<p>)?\s*\[!(NOTE|TIP|IMPORTANT|WARNING|CAUTION)\]\s*(?:<\/p>)?\s*(?:<br\s*\/?>)?\s*([\s\S]*?)<\/blockquote>/gi;

    return htmlContent.replace(regex, (match, type, content) => {
        const typeLower = type.toLowerCase();

        return `
            <div class="md-alert md-alert-${typeLower} not-prose mb-6 rounded-xl border border-l-4 p-4 text-sm">
                <div class="md-alert-header font-bold mb-2 uppercase tracking-wide flex items-center gap-2">
                    <span class="md-alert-title">${type}</span>
                </div>
                <div class="md-alert-content prose prose-sm prose-zinc dark:prose-invert max-w-none">
                    ${content}
                </div>
            </div>
        `;
    });
};

export async function getStaticPaths() {
    const { data: posts, error } = await supabase.from("posts").select("*");

    if (error || !posts || posts.length === 0) {
        throw new Error(
            "Proses Build Gagal: Tidak dapat mengambil data posts dari Supabase."
        );
    }

    return (
        posts?.map((post) => {
            const categoryPath =
                post.category === "note"
                    ? "notes"
                    : post.category === "work"
                    ? "works"
                    : post.category === "til"
                    ? "til"
                    : "snaps";

            return {
                params: {
                    category: categoryPath,
                    slug: post.slug,
                },
                props: { post },
            };
        }) || []
    );
}

const { category, slug } = Astro.params;
const { post } = Astro.props;

const finalContent = parseMarkdownAlerts(post.content);

const formatDate = (dateString) => {
    if (!dateString) return "";

    return new Date(dateString).toLocaleDateString("id-ID", {
        day: "numeric",
        month: "short",
        year: "numeric",
    });
};

const getExcerpt = (htmlContent, maxLength = 155) => {
    if (!htmlContent) return "";

    const cleanText = htmlContent.replace(/<[^>]*>/g, " ");
    const normalizedSpaces = cleanText.replace(/\s+/g, " ").trim();

    if (normalizedSpaces.length <= maxLength) {
        return normalizedSpaces;
    }

    return normalizedSpaces.substring(0, maxLength).trim() + "...";
};

const seoDescription = post.excerpt || getExcerpt(post.content);

const seoImage =
    post.image ||
    "https://images.unsplash.com/photo-1509198397868-475647b2a1e5?q=80&w=800&auto=format&fit=crop";

const jsonLd = {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: post.title,
    description: seoDescription,
    image: [seoImage],
    datePublished: post.created_at,
    dateModified: post.updated_at || post.created_at,
    author: {
        "@type": "Person",
        name: "Ahmad Royhan Najib (Han Najib)",
        url: "https://hannajibnotes.vercel.app",
    },
    publisher: {
        "@type": "Person",
        name: "Han Najib",
        url: "https://hannajibnotes.vercel.app",
    },
    mainEntityOfPage: {
        "@type": "WebPage",
        "@id": Astro.url.href,
    },
};

const disqusShortname =
    import.meta.env.PUBLIC_DISQUS_SHORTNAME || "hannajib-notes-works";

const pageUrl = Astro.url.href;
const pageIdentifier = post.id;
---

<Layout
    title={`${post.title} — HanNajib`}
    description={seoDescription}
    ogImage={seoImage}
    ogType="article"
    showHero={false}
>
    <script
        type="application/ld+json"
        slot="head"
        set:html={JSON.stringify(jsonLd)}
    ></script>

    <div class="max-w-2xl mx-auto py-6">
        {
            post.category === "snap" && post.image && (
                <div class="mb-8 overflow-hidden rounded-2xl border border-zinc-200/70 dark:border-zinc-800">
                    <img
                        src={post.image}
                        alt={post.title}
                        class="w-full max-h-[500px] object-cover"
                        loading="eager"
                        decoding="async"
                    />
                </div>
            )
        }

        <article>
            <header class="mb-8">
                <div
                    class="flex items-center gap-2 text-xs font-mono text-zinc-400 mb-3"
                >
                    <span class="lowercase">
                        {
                            post.category === "note"
                                ? "notes"
                                : post.category === "work"
                                ? "works"
                                : post.category === "til"
                                ? "til"
                                : "snaps"
                        }
                    </span>

                    <span>/</span>

                    <span>{formatDate(post.created_at)}</span>

                    {
                        post.read_time && (
                            <>
                                <span>/</span>
                                <span>{post.read_time} min read</span>
                            </>
                        )
                    }
                    <span>•</span>
                    <span>{post.views || 0} views</span>
                </div>

                <h1
                    class="text-3xl sm:text-4xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100 leading-tight"
                >
                    {post.title}
                </h1>
            </header>

            {
                post.category !== "snap" && post.image && (
                    <div class="mb-8 overflow-hidden rounded-2xl border border-zinc-200/70 dark:border-zinc-800">
                        <img
                            src={post.image}
                            alt={post.title}
                            class="w-full max-h-[450px] object-cover"
                        />
                    </div>
                )
            }

            <div
                class="prose prose-zinc dark:prose-invert max-w-none leading-7 prose-p:my-3 prose-ul:list-disc prose-ul:pl-6 prose-ol:list-decimal prose-ol:pl-6 prose-li:my-1 prose-li:marker:text-zinc-500 prose-headings:font-bold prose-headings:tracking-tight prose-headings:scroll-mt-24 prose-h1:text-4xl prose-h1:mb-4 prose-h2:text-2xl prose-h2:mt-10 prose-h2:mb-3 prose-h3:text-xl prose-h3:mt-8 prose-h3:mb-2 prose-img:rounded-2xl prose-img:my-6 prose-pre:rounded-2xl prose-pre:px-4 prose-pre:py-4 prose-code:text-[0.9em] prose-code:before:content-none prose-code:after:content-none prose-a:no-underline hover:prose-a:underline"
                set:html={finalContent}
            >
            </div>
        </article>

        <section
            class="mt-20 pt-8 border-t border-zinc-200/70 dark:border-zinc-800 disqus-container"
        >
            <h2
                class="text-lg font-semibold text-zinc-900 dark:text-zinc-100 mb-6"
            >
                Diskusi
            </h2>

            <div id="disqus_thread"></div>

            <script
                is:inline
                define:vars={{
                    disqusShortname,
                    pageUrl,
                    pageIdentifier,
                }}
            >
                window.disqus_config = function () {
                    this.page.url = pageUrl;
                    this.page.identifier = pageIdentifier;
                };

                (() => {
                    if (document.getElementById("disqus-script")) {
                        return;
                    }

                    const script = document.createElement("script");

                    script.src = `https://${disqusShortname}.disqus.com/embed.js`;

                    script.id = "disqus-script";
                    script.async = true;
                    script.setAttribute("data-timestamp", String(+new Date()));

                    document.body.appendChild(script);
                })();
            </script>

            <noscript> Please enable JavaScript to load comments.</noscript>
        </section>
    </div>

    <script define:vars={{ slug: post.slug }}>
        import { supabase } from "../../lib/supabase";
        async function trackView() {
            const sessionKey = `viewed_${slug}`;
            if (!sessionStorage.getItem(sessionKey)) {
                const { error } = await supabase.rpc("increment_views", {
                    post_slug: slug,
                });
                if (!error) {
                    sessionStorage.setItem(sessionKey, "true");
                }
            }
        }
        trackView();
    </script>
</Layout>
