---
export const prerender = true;
import Layout from "../../layouts/Layout.astro";
import { supabase } from "../../lib/supabase";

const parseMarkdownAlerts = (htmlContent) => {
    if (!htmlContent) return "";

    const regex =
        /<blockquote>\s*(?:<p>)?\s*\[!(NOTE|TIP|IMPORTANT|WARNING|CAUTION)\]\s*(?:<\/p>)?\s*(?:<br\s*\/?>)?\s*([\s\S]*?)<\/blockquote>/gi;

    return htmlContent.replace(regex, (match, type, content) => {
        const typeLower = type.toLowerCase();

        return `
            <div class="md-alert md-alert-${typeLower} not-prose mb-6 rounded-xl border border-l-4 p-4 text-sm">
                <div class="md-alert-header font-bold mb-2 uppercase tracking-wide flex items-center gap-2">
                    <span class="md-alert-title">${type}</span>
                </div>
                <div class="md-alert-content prose prose-sm prose-zinc dark:prose-invert max-w-none">
                    ${content}
                </div>
            </div>
        `;
    });
};

export async function getStaticPaths() {
    const { data: posts, error } = await supabase.from("posts").select("*");

    if (error || !posts || posts.length === 0) {
        throw new Error(
            "Proses Build Gagal: Tidak dapat mengambil data posts dari Supabase.",
        );
    }

    return (
        posts?.map((post) => {
            const categoryPath =
                post.category === "note"
                    ? "notes"
                    : post.category === "work"
                      ? "works"
                      : post.category === "til"
                        ? "til"
                        : "snaps";

            return {
                params: {
                    category: categoryPath,
                    slug: post.slug,
                },
                props: {
                    post,
                    relatedPosts: posts
                        .filter(
                            (candidate) =>
                                candidate.category === post.category &&
                                candidate.slug !== post.slug,
                        )
                        .sort(
                            (firstPost, secondPost) =>
                                new Date(secondPost.created_at).getTime() -
                                new Date(firstPost.created_at).getTime(),
                        )
                        .slice(0, 3),
                },
            };
        }) || []
    );
}

const { category, slug } = Astro.params;
const { post, relatedPosts } = Astro.props;

const finalContent = parseMarkdownAlerts(post.content);

const formatDate = (dateString) => {
    if (!dateString) return "";

    return new Date(dateString).toLocaleDateString("id-ID", {
        day: "numeric",
        month: "short",
        year: "numeric",
    });
};

const getExcerpt = (htmlContent, maxLength = 155) => {
    if (!htmlContent) return "";

    const cleanText = htmlContent.replace(/<[^>]*>/g, " ");
    const normalizedSpaces = cleanText.replace(/\s+/g, " ").trim();

    if (normalizedSpaces.length <= maxLength) {
        return normalizedSpaces;
    }

    return normalizedSpaces.substring(0, maxLength).trim() + "...";
};

const seoDescription = post.excerpt || getExcerpt(post.content);

const seoImage =
    post.image ||
    `https://textstretch.hannajib.my.id/api/og?teks=${encodeURIComponent(post.title)}&width=1200&height=630`;

const jsonLd = {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: post.title,
    description: seoDescription,
    image: [seoImage],
    datePublished: post.created_at,
    dateModified: post.updated_at || post.created_at,
    author: {
        "@type": "Person",
        name: "Ahmad Royhan Najib (Han Najib)",
        url: "https://blog.hannajib.web.id",
    },
    publisher: {
        "@type": "Person",
        name: "Han Najib",
        url: "https://blog.hannajib.web.id",
    },
    mainEntityOfPage: {
        "@type": "WebPage",
        "@id": Astro.url.href,
    },
};

const disqusShortname =
    import.meta.env.PUBLIC_DISQUS_SHORTNAME || "hannajib-notes-works";

const pageUrl = Astro.url.href;
const pageIdentifier = post.id;
---

<Layout
    title={`${post.title} — HanNajib`}
    description={seoDescription}
    ogImage={seoImage}
    ogType="article"
    showHero={false}
>
    <script
        type="application/ld+json"
        slot="head"
        set:html={JSON.stringify(jsonLd)}
    />
    <link
        slot="head"
        href="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.snow.css"
        rel="stylesheet"
    />

    <div class="max-w-4xl mx-auto py-6 md:py-10">
        <div class="mb-8">
            <a
                href="/"
                class="inline-flex items-center gap-1.5 text-xs md:text-sm text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-200 transition-colors font-mono"
            >
                &larr; Kembali ke Beranda
            </a>
        </div>

        {
            post.category === "snap" && post.image && (
                <div class="mb-10 overflow-hidden rounded-2xl md:rounded-3xl border border-zinc-200/70 dark:border-zinc-800">
                    <img
                        src={post.image}
                        alt={post.title}
                        class="w-full h-auto"
                        loading="eager"
                        decoding="async"
                    />
                </div>
            )
        }

        <article>
            <header class="mb-10 md:mb-14">
                <div
                    class="flex items-center gap-2 md:gap-3 text-xs md:text-sm font-mono text-zinc-400 mb-4"
                >
                    <span class="lowercase">
                        {
                            post.category === "note"
                                ? "notes"
                                : post.category === "work"
                                  ? "works"
                                  : post.category === "til"
                                    ? "til"
                                    : "snaps"
                        }
                    </span>

                    <span>/</span>

                    <span>{formatDate(post.created_at)}</span>

                    {
                        post.read_time && (
                            <>
                                <span>/</span>
                                <span>{post.read_time} min read</span>
                            </>
                        )
                    }
                    <span>/</span>
                    <span id="view-count-display">{post.views || 0} views</span>
                </div>

                <h1
                    class="text-[32px] sm:text-4xl md:text-[40px] font-extrabold tracking-tight text-zinc-900 dark:text-zinc-50 leading-[1.2] md:leading-[1.15]"
                    style="text-wrap: balance;"
                >
                    {post.title}
                </h1>
            </header>

            {
                post.category !== "snap" && post.image && (
                    <div class="mb-12 md:mb-16 overflow-hidden rounded-2xl md:rounded-3xl border border-zinc-200/70 dark:border-zinc-800 shadow-sm">
                        <img
                            src={post.image}
                            alt={post.title}
                            class="w-full max-h-[450px] md:max-h-[600px] object-cover"
                        />
                    </div>
                )
            }

            <div class="ql-snow">
                <div
                    class="ql-editor prose prose-zinc dark:prose-invert max-w-none md:prose-lg leading-loose
                    prose-p:my-5 md:prose-p:my-6
                    prose-ul:list-disc prose-ul:pl-6 prose-ol:list-decimal prose-ol:pl-6
                    prose-li:my-2 prose-li:marker:text-zinc-500
                    prose-headings:font-bold prose-headings:tracking-tight prose-headings:scroll-mt-28
                    prose-h2:text-2xl md:prose-h2:text-3xl prose-h2:mt-12 prose-h2:mb-5
                    prose-h3:text-xl md:prose-h3:text-2xl prose-h3:mt-8 prose-h3:mb-3
                    prose-img:rounded-2xl md:prose-img:rounded-3xl prose-img:my-8 prose-img:shadow-md
                    prose-pre:rounded-2xl md:prose-pre:rounded-3xl prose-pre:px-6 prose-pre:py-5 prose-pre:shadow-sm
                    prose-code:text-[0.9em] prose-code:before:content-none prose-code:after:content-none
                    prose-code:bg-zinc-100 dark:prose-code:bg-zinc-800 prose-code:text-pink-600 dark:prose-code:text-pink-400 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded-md prose-code:font-medium
                    prose-blockquote:border-l-4 prose-blockquote:border-zinc-900 dark:prose-blockquote:border-zinc-100 prose-blockquote:bg-zinc-50 dark:prose-blockquote:bg-zinc-900/40 prose-blockquote:py-2 prose-blockquote:px-5 prose-blockquote:rounded-r-xl prose-blockquote:font-normal prose-blockquote:not-italic prose-blockquote:text-zinc-700 dark:prose-blockquote:text-zinc-300
                    prose-a:no-underline hover:prose-a:underline prose-a:underline-offset-4 prose-a:decoration-zinc-300 dark:prose-a:decoration-zinc-700"
                    style="padding: 0 !important; min-height: auto !important;"
                    set:html={finalContent}
                />
            </div>
        </article>

        {
            relatedPosts.length > 0 && (
                <section class="mt-20 pt-10 border-t border-zinc-200/70 dark:border-zinc-800">
                    <h2 class="text-xl md:text-2xl font-bold text-zinc-900 dark:text-zinc-100 mb-8 tracking-tight">
                        
                    </h2>

                    <div class="grid gap-6 md:grid-cols-3">
                        {relatedPosts.map((relatedPost) => {
                            const relatedCategoryPath =
                                relatedPost.category === "note"
                                    ? "notes"
                                    : relatedPost.category === "work"
                                      ? "works"
                                      : relatedPost.category === "til"
                                        ? "til"
                                        : "snaps";

                            return (
                                <a
                                    href={`/${relatedCategoryPath}/${relatedPost.slug}`}
                                    class="group block border-b border-zinc-200/70 pb-4 dark:border-zinc-800 md:border-b-0 md:border-l md:pl-5"
                                >
                                    <span class="font-mono text-xs uppercase tracking-wider text-zinc-400 dark:text-zinc-500">
                                        {relatedPost.category}
                                    </span>
                                    <h3 class="mt-2 text-base font-bold leading-snug text-zinc-900 transition-colors group-hover:text-zinc-500 dark:text-zinc-100 dark:group-hover:text-zinc-400">
                                        {relatedPost.title}
                                    </h3>
                                </a>
                            );
                        })}
                    </div>
                </section>
            )
        }

        <section
            class="mt-24 pt-10 border-t border-zinc-200/70 dark:border-zinc-800 disqus-container"
        >
            <h2
                class="text-xl md:text-2xl font-bold text-zinc-900 dark:text-zinc-100 mb-8 tracking-tight"
            >
                Diskusi
            </h2>

            <div id="disqus_thread"></div>

            <script
                is:inline
                define:vars={{
                    disqusShortname,
                    pageUrl,
                    pageIdentifier,
                }}
            >
                window.disqus_config = function () {
                    this.page.url = pageUrl;
                    this.page.identifier = pageIdentifier;
                };

                (() => {
                    if (document.getElementById("disqus-script")) {
                        return;
                    }

                    const script = document.createElement("script");

                    script.src = `https://${disqusShortname}.disqus.com/embed.js`;

                    script.id = "disqus-script";
                    script.async = true;
                    script.setAttribute("data-timestamp", String(+new Date()));

                    document.body.appendChild(script);
                })();
            </script>

            <noscript> Please enable JavaScript to load comments.</noscript>
        </section>
    </div>

    <!-- Element pembawa metadata untuk script client-side -->
    <div
        id="view-tracker"
        data-slug={post.slug}
        data-id={post.id}
        class="hidden"
    >
    </div>

    <script>
        import { supabase } from "../../lib/supabase";

        async function trackAndFetchViews() {
            const tracker = document.getElementById("view-tracker");
            if (!tracker) return;

            const slug = tracker.dataset.slug;
            const postId = tracker.dataset.id;
            if (!slug || !postId) return;

            const sessionKey = `viewed_${slug}`;

            try {
                if (!sessionStorage.getItem(sessionKey)) {
                    const { error } = await supabase.rpc("increment_views", {
                        post_slug: slug,
                    });
                    if (!error) {
                        sessionStorage.setItem(sessionKey, "true");
                    }
                }

                const { data, error } = await supabase
                    .from("post_views")
                    .select("views")
                    .eq("post_id", postId)
                    .maybeSingle();

                const viewsCount =
                    data && data.views !== undefined ? data.views : 0;
                const displayEl = document.getElementById("view-count-display");
                if (displayEl) {
                    displayEl.innerText = `${viewsCount} views`;
                }
            } catch (err) {
                console.error("Gagal memproses hitungan views:", err);
            }
        }

        // Jalankan pelacakan saat halaman dimuat di sisi klien
        trackAndFetchViews();
    </script>
</Layout>
