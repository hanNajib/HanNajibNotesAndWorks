---
import Layout from "../../layouts/Layout.astro";
import { supabase } from "../../lib/supabase";

export async function getStaticPaths() {
    const { data: posts } = await supabase
        .from("posts")
        .select("slug, category");

    return (
        posts?.map((post) => {
            // Menyelaraskan string DB dengan parameter URL slug
            const categoryPath =
                post.category === "note"
                    ? "notes"
                    : post.category === "work"
                    ? "works"
                    : post.category === "til"
                    ? "til"
                    : "snaps";

            return {
                params: {
                    category: categoryPath,
                    slug: post.slug,
                },
            };
        }) || []
    );
}

// 2. Ambil parameter slug dari URL aktif
const { slug } = Astro.params;

// 3. Ambil data spesifik tulisan tersebut dari database Supabase
const { data: post } = await supabase
    .from("posts")
    .select("*")
    .eq("slug", slug)
    .single();

// Jika data tidak ditemukan di database, arahkan ke halaman 404
if (!post) {
    return Astro.redirect("/404");
}

// Fungsi pembantu pemformat tanggal khas blog minimalis kita
const formatDate = (dateString) => {
    if (!dateString) return "";
    const options = { day: "numeric", month: "short", year: "numeric" };
    return new Date(dateString).toLocaleDateString("id-ID", options);
};

// Helper untuk membersihkan tag HTML dari Quill rich text dan mengambil teks bersih untuk SEO
const getExcerpt = (htmlContent, maxLength = 155) => {
    if (!htmlContent) return "";
    // 1. Hapus semua tag HTML menggunakan regex
    const cleanText = htmlContent.replace(/<[^>]*>/g, " ");
    // 2. Rapikan spasi berlebih
    const normalizedSpaces = cleanText.replace(/\s+/g, " ").trim();
    // 3. Potong sesuai panjang maksimal dan tambahkan ellipsis jika terpotong
    if (normalizedSpaces.length <= maxLength) return normalizedSpaces;
    return normalizedSpaces.substring(0, maxLength).trim() + "...";
};

// Buat deskripsi dinamis dan gambar cover dinamis
const seoDescription = post.excerpt || getExcerpt(post.content);
const seoImage =
    post.image ||
    "https://images.unsplash.com/photo-1509198397868-475647b2a1e5?q=80&w=800&auto=format&fit=crop"; // fallback default

const jsonLd = {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: post.title,
    description: seoDescription,
    image: [seoImage],
    datePublished: post.created_at,
    dateModified: post.updated_at || post.created_at,
    author: {
        "@type": "Person",
        name: "Ahmad Royhan Najib (Han Najib)",
        url: "https://hannajib.dev", // Ubah sesuai domain aslimu nanti
    },
    publisher: {
        "@type": "Person",
        name: "Han Najib",
        url: "https://hannajib.dev",
    },
    mainEntityOfPage: {
        "@type": "WebPage",
        "@id": Astro.url.href,
    },
};
---

<Layout
    title={`${post.title} — HanNajib`}
    description={seoDescription}
    ogImage={seoImage}
    ogType="article"
    showHero={false}
>
    <script
        type="application/ld+json"
        slot="head"
        set:html={JSON.stringify(jsonLd)}
    ></script>
    <div class="max-w-2xl mx-auto py-4">
        <!-- <div class="mb-2">
            <a
                href="/"
                class="inline-flex items-center space-x-2 text-xs font-mono tracking-wider uppercase text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-200 transition-all duration-200 group py-1.5 px-3 -ml-3 rounded-md hover:bg-zinc-100/70 dark:hover:bg-zinc-800/50"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="w-3.5 h-3.5 transform group-hover:-translate-x-0.5 transition-transform duration-200 ease-out flex-shrink-0"
                >
                    <path d="M19 12H5M12 19l-7-7 7-7"></path>
                </svg>
                <span class="relative top-[0.5px] leading-none"
                    >Back to feed</span
                >
            </a>
        </div> -->

        <!-- Tampilan Gambar Utama Khusus Kategori Snaps (Gambar ditaruh paling atas ala editorial) -->
        {
            post.category === "snap" && post.image && (
                <div class="mb-8 overflow-hidden rounded-lg border border-zinc-100 dark:border-zinc-800/80 bg-zinc-50 dark:bg-zinc-900/50">
                    <img
                        src={post.image}
                        alt={post.title}
                        class="w-full max-h-[450px] object-cover"
                    />
                </div>
            )
        }

        <!-- Isi Artikel Bacaan Utama -->
        <article class="prose dark:prose-invert max-w-none">
            <header class="mb-6">
                <!-- Metadata Atas Lembut & Monospace -->
                <div
                    class="flex items-center space-x-2 text-xs text-zinc-400 font-mono mb-2.5"
                >
                    <span class="lowercase text-zinc-500 dark:text-zinc-400">
                        {
                            post.category === "note"
                                ? "notes"
                                : post.category === "work"
                                ? "works"
                                : post.category === "til"
                                ? "til"
                                : "snaps"
                        }
                    </span>
                    <span>/</span>
                    <span>{formatDate(post.created_at)}</span>
                    {
                        post.read_time && (
                            <>
                                <span>/</span>
                                <span>{post.read_time}</span>
                            </>
                        )
                    }
                </div>

                <h1
                    class="sm:text-3xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100 leading-snug"
                >
                    {post.title}
                </h1>
            </header>

            <!-- Tampilan Gambar Utama untuk Kategori non-Snaps (Misal Portofolio/Works) -->
            {
                post.category !== "snap" && post.image && (
                    <div class="mb-6 overflow-hidden rounded-lg border border-zinc-100 dark:border-zinc-800/80 bg-zinc-50 dark:bg-zinc-900/50">
                        <img
                            src={post.image}
                            alt={post.title}
                            class="w-full max-h-96 object-cover"
                        />
                    </div>
                )
            }

            <!-- Konten Isi Blok Teks Utama (16px / text-base, Rich HTML dari Quill) -->
            <div
                class="text-base text-zinc-650 dark:text-zinc-300 leading-relaxed space-y-6 prose dark:prose-invert max-w-none"
                set:html={post.content}
            >
            </div>
        </article>

        <!-- Divider Bawah Khas Versi 1 -->
        <div class="mt-12 pt-4 border-t border-zinc-100 dark:border-zinc-900">
        </div>
    </div>
</Layout>
